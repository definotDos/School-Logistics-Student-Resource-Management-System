NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/school_logistics
JWT_SECRET=
OTP_SECRET=
AUTH_AUDIT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
# Only set behind a known reverse proxy; otherwise leave blank.
TRUST_PROXY_HOPS=
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-provider-password
EMAIL_FROM=School Logistics <your-email@example.com>
