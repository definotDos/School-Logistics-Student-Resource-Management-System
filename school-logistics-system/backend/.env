PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/school_logistics
JWT_SECRET=school_logistics_secret

# Use Gmail as the specific email provider for signup verification codes.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-real-gmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-real-gmail@gmail.com

# Important:
# 1) Replace the values above with your actual Gmail address and Google App Password.
# 2) Generate the app password here: https://myaccount.google.com/apppasswords
# 3) Restart the backend after saving.
# 4) The verification code is sent to the email the user types during signup.

# If SMTP_USER and SMTP_PASS are still placeholders, the app falls back to a temporary Ethereal test account instead of sending to your real inbox.
